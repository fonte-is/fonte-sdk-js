{
  "name": "@fonte-is/react",
  "version": "0.1.0",
  "description": "React bindings over @fonte-is/core",
  "license": "Apache-2.0",
  "homepage": "https://fonte.is",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonte-is/fonte-sdk-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/fonte-is/fonte-sdk-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@fonte-is/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
