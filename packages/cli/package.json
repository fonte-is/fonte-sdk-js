{
  "name": "@fonte-is/cli",
  "version": "0.3.0",
  "description": "Manage Fonte production broadcast operator journeys and local installations",
  "license": "Apache-2.0",
  "homepage": "https://fonte.is",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonte-is/fonte-sdk-js.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fonte-is/fonte-sdk-js/issues"
  },
  "type": "module",
  "exports": {
    "./operator-client": {
      "types": "./dist/operator-client.d.ts",
      "import": "./dist/operator-client.js"
    }
  },
  "bin": {
    "fonte": "./dist/main.js",
    "fonte-mcp": "./dist/mcp-main.js"
  },
  "files": [
    "dist",
    "assets",
    "native",
    "LICENSE",
    "MCP_CONTRACT.md",
    "README.md",
    "OPERATOR_CONTRACT.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:strict": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "openid-client": "6.8.5",
    "zod": "4.4.3"
  }
}
